<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.LoginPage"
             BackgroundColor="#121212">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="ALEPULSE"
               FontSize="40"
               FontAttributes="Bold"
               TextColor="#FF6A00"
               HorizontalOptions="Center" />

        <Label Text="Treine. Evolua. Supere."
               FontSize="16"
               TextColor="#E0E0E0"
               HorizontalOptions="Center"
               Margin="0,0,0,30" />

        <Frame BackgroundColor="#1E1E1E" BorderColor="#2B2B2B" CornerRadius="10" Padding="15">
            <Entry x:Name="EmailEntry"
                   Placeholder="E-mail"
                   PlaceholderColor="#888888"
                   TextColor="#FFFFFF"
                   Keyboard="Email" />
        </Frame>

        <Frame BackgroundColor="#1E1E1E" BorderColor="#2B2B2B" CornerRadius="10" Padding="15">
            <Entry x:Name="PasswordEntry"
                   Placeholder="Senha"
                   PlaceholderColor="#888888"
                   TextColor="#FFFFFF"
                   IsPassword="True" />
        </Frame>

        <Button x:Name="LoginButton"
                Text="ENTRAR"
                BackgroundColor="#FF6A00"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnLoginClicked" />

        <Label x:Name="ErrorLabel"
               TextColor="Red"
               IsVisible="False"
               HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>