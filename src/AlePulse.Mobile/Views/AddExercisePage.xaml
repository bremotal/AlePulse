<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.AddExercisePage"
             BackgroundColor="#121212"
             Title="Adicionar Exercício">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="ESCOLHA O EXERCÍCIO"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   Margin="0,20,0,10" />

            <!-- Lista de Exercícios (Picker) -->
            <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Picker x:Name="ExercisePicker"
                        Title="Selecione um exercício da biblioteca..."
                        TitleColor="#888888"
                        TextColor="#FFFFFF"
                        ItemDisplayBinding="{Binding Name}" />
            </Border>

            <Label Text="OU CRIE UM NOVO (Opcional)"
                   FontSize="16"
                   TextColor="#E0E0E0"
                   Margin="0,10,0,0" />

            <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Entry x:Name="NewExerciseEntry"
                       Placeholder="Nome do novo exercício"
                       PlaceholderColor="#888888"
                       TextColor="#FFFFFF" />
            </Border>

            <!-- Campos de Carga, Séries, etc -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Séries" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="SetsEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="4" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Reps" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="RepsEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="10" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="5">
                    <Label Text="Descanso" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="RestEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="90" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="5">
                <Label Text="Carga (kg)" TextColor="#E0E0E0" />
                <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="WeightEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="20" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="CANCELAR"
                        BackgroundColor="#2B2B2B"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCancelClicked" />

                <Button Grid.Column="1"
                        Text="ADICIONAR"
                        BackgroundColor="#FF6A00"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnAddClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>