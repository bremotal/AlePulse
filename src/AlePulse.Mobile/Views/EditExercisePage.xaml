<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.EditExercisePage"
             BackgroundColor="#121212"
             Title="Editar Exercício">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label x:Name="TitleLabel"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   Margin="0,20,0,10" />

            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">
                <VerticalStackLayout Grid.Column="0" Spacing="5">
                    <Label Text="Séries" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="SetsEntry" TextColor="#FFFFFF" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="1" Spacing="5">
                    <Label Text="Reps" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="RepsEntry" TextColor="#FFFFFF" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Column="2" Spacing="5">
                    <Label Text="Descanso (s)" TextColor="#E0E0E0" />
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10" />
                        </Border.StrokeShape>
                        <Entry x:Name="RestEntry" TextColor="#FFFFFF" Keyboard="Numeric" />
                    </Border>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Spacing="5">
                <Label Text="Carga (kg)" TextColor="#E0E0E0" />
                <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10" />
                    </Border.StrokeShape>
                    <Entry x:Name="WeightEntry" TextColor="#FFFFFF" Keyboard="Numeric" />
                </Border>
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*, *" ColumnSpacing="15" Margin="0,10,0,20">
                <Button Grid.Column="0"
                        Text="CANCELAR"
                        BackgroundColor="#2B2B2B"
                        TextColor="#FFFFFF"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnCancelClicked" />

                <Button Grid.Column="1"
                        Text="SALVAR"
                        BackgroundColor="#FF6A00"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        CornerRadius="10"
                        HeightRequest="50"
                        Clicked="OnSaveClicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>