<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.WorkoutDetailPage"
             BackgroundColor="{AppThemeBinding Dark=#121212, Light=#F9F9F9}"
             Title="Detalhes do Treino">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">

        <!-- Cabeçalho do Treino -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,20,0,20">
            <Label x:Name="WorkoutNameLabel"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" />
            <Label x:Name="WorkoutDescLabel"
                   FontSize="16"
                   TextColor="{AppThemeBinding Dark=#E0E0E0, Light=#666666}" />
        </VerticalStackLayout>

        <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="{AppThemeBinding Dark=#2B2B2B, Light=#E0E0E0}" Margin="0,0,0,20" />

        <!-- Lista de Exercícios do Treino -->
        <CollectionView x:Name="ExercisesList" Grid.Row="2" BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <Label Text="Nenhum exercício adicionado a este treino."
                       TextColor="{AppThemeBinding Dark=#888888, Light=#666666}"
                       FontSize="16"
                       HorizontalOptions="Center"
                       Margin="0,50,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="{AppThemeBinding Dark=#1E1E1E, Light=#FFFFFF}" Stroke="{AppThemeBinding Dark=#2B2B2B, Light=#EEEEEE}" Margin="0,0,0,15" Padding="15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExerciseTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>

                        <!-- Grid com 4 colunas: Dados, Upload, Editar, Excluir -->
                        <Grid ColumnDefinitions="*, Auto, Auto, Auto" RowDefinitions="Auto, Auto">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Exercise.Name}"
                                   TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,5,0,0">
                                <Label Text="{Binding Sets, StringFormat='{0} séries'}" TextColor="{AppThemeBinding Dark=#888888, Light=#666666}" FontSize="14" />
                                <Label Text="{Binding Repetitions, StringFormat='{0} reps'}" TextColor="{AppThemeBinding Dark=#888888, Light=#666666}" FontSize="14" />
                                <Label Text="{Binding Weight, StringFormat='{0} kg'}" TextColor="{AppThemeBinding Dark=#888888, Light=#666666}" FontSize="14" />
                            </HorizontalStackLayout>

                            <!-- Botão de Upload de Imagem -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="📷"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF6A00"
                                    FontSize="20"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center"
                                    Clicked="OnUploadImageClicked" />

                            <!-- Botão de Editar -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                    Text="✏️"
                                    BackgroundColor="Transparent"
                                    TextColor="#FF6A00"
                                    FontSize="20"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center"
                                    Clicked="OnEditExerciseClicked" />

                            <!-- Botão de Excluir -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="3"
                                    Text="🗑️"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    FontSize="20"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteExerciseClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="VOLTAR"
                    BackgroundColor="{AppThemeBinding Dark=#2B2B2B, Light=#E0E0E0}"
                    TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="1"
                    Text="+ EXERCÍCIO"
                    BackgroundColor="Transparent"
                    TextColor="#FF6A00"
                    BorderColor="#FF6A00"
                    BorderWidth="2"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnAddExerciseClicked" />

            <Button Grid.Column="2"
                    Text="INICIAR"
                    BackgroundColor="#FF6A00"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnStartWorkoutClicked" />
        </Grid>

    </Grid>
</ContentPage>