<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.WorkoutDetailPage"
             BackgroundColor="#121212"
             Title="Detalhes do Treino">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">

        <!-- Cabeçalho do Treino -->
        <VerticalStackLayout Grid.Row="0" Spacing="5" Margin="0,20,0,20">
            <Label x:Name="WorkoutNameLabel"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF" />
            <Label x:Name="WorkoutDescLabel"
                   FontSize="16"
                   TextColor="#E0E0E0" />
        </VerticalStackLayout>

        <BoxView Grid.Row="1" HeightRequest="1" BackgroundColor="#2B2B2B" Margin="0,0,0,20" />

        <!-- Lista de Exercícios do Treino -->
        <CollectionView x:Name="ExercisesList" Grid.Row="2" BackgroundColor="Transparent">
            <CollectionView.EmptyView>
                <Label Text="Nenhum exercício adicionado a este treino."
                       TextColor="#888888"
                       FontSize="16"
                       HorizontalOptions="Center"
                       Margin="0,50,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Margin="0,0,0,15" Padding="15">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnExerciseTapped" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="15" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*, Auto" RowDefinitions="Auto, Auto">

                            <Label Grid.Row="0" Grid.Column="0"
                                   Text="{Binding Exercise.Name}"
                                   TextColor="#FFFFFF"
                                   FontSize="20"
                                   FontAttributes="Bold" />

                            <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="10" Margin="0,5,0,0">
                                <Label Text="{Binding Sets, StringFormat='{0} séries'}" TextColor="#888888" FontSize="14" />
                                <Label Text="{Binding Repetitions, StringFormat='{0} reps'}" TextColor="#888888" FontSize="14" />
                                <Label Text="{Binding Weight, StringFormat='{0} kg'}" TextColor="#888888" FontSize="14" />
                            </HorizontalStackLayout>

                            <!-- Botão de Excluir Exercício -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="🗑️"
                                    BackgroundColor="Transparent"
                                    TextColor="Red"
                                    FontSize="20"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center"
                                    Clicked="OnDeleteExerciseClicked" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé -->
        <Grid Grid.Row="3" ColumnDefinitions="*, *, *" ColumnSpacing="10">
            <Button Grid.Column="0"
                    Text="VOLTAR"
                    BackgroundColor="#2B2B2B"
                    TextColor="#FFFFFF"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnBackClicked" />

            <Button Grid.Column="1"
                    Text="+ EXERCÍCIO"
                    BackgroundColor="#1E1E1E"
                    TextColor="#FFFFFF"
                    BorderColor="#FF6A00"
                    BorderWidth="1"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnAddExerciseClicked" />

            <Button Grid.Column="2"
                    Text="INICIAR"
                    BackgroundColor="#FF6A00"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnStartWorkoutClicked" />
        </Grid>

    </Grid>
</ContentPage>