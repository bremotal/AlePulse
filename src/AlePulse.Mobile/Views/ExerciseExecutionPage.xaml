<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.ExerciseExecutionPage"
             BackgroundColor="#121212"
             Title="Treino Ativo">

    <Grid RowDefinitions="Auto, Auto, Auto, Auto, *, Auto" Padding="20">

        <!-- Navegação entre Exercícios -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,20,0,15">
            <Button Grid.Column="0" Text="‹" FontSize="24" FontAttributes="Bold" BackgroundColor="#2B2B2B" TextColor="#FFFFFF" WidthRequest="50" CornerRadius="25" Clicked="OnPrevClicked"/>
            <Picker Grid.Column="1" x:Name="ExercisePicker" Title="Trocar Exercício" TitleColor="#888888" TextColor="#FFFFFF" HorizontalOptions="Center" BackgroundColor="#1E1E1E" ItemDisplayBinding="{Binding Exercise.Name}" SelectedIndexChanged="OnExerciseChanged"/>
            <Button Grid.Column="2" Text="›" FontSize="24" FontAttributes="Bold" BackgroundColor="#2B2B2B" TextColor="#FFFFFF" WidthRequest="50" CornerRadius="25" Clicked="OnNextClicked"/>
        </Grid>

        <!-- Título do Exercício Atual -->
        <Label Grid.Row="1" x:Name="TitleLabel" FontSize="24" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center" Margin="0,0,0,15"/>

        <!-- Registro da Série Atual -->
        <Border Grid.Row="2" BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15" Margin="0,0,0,15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="REGISTRAR SÉRIE" TextColor="#FF6A00" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Button Grid.Column="1" x:Name="LoadHistoryBtn" Text="Usar Último" BackgroundColor="#2B2B2B" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="40" Clicked="OnLoadHistoryClicked"/>
                </Grid>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Série" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="SetEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="1"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Peso (kg)" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="WeightEntry" TextColor="#FFFFFF" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="Reps" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="RepsEntry" TextColor="#FFFFFF" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Button x:Name="SaveBtn" Text="REGISTRAR SÉRIE" BackgroundColor="#FF6A00" TextColor="#FFFFFF" CornerRadius="10" Clicked="OnSaveSetClicked"/>
            </VerticalStackLayout>
        </Border>

        <!-- CRONÔMETRO DE DESCANSO -->
        <Border Grid.Row="3" x:Name="RestTimerBorder" BackgroundColor="#2B2B2B" Stroke="#FF6A00" Padding="15" Margin="0,0,0,15" IsVisible="False">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="10" HorizontalOptions="Center">
                <Label Text="DESCANSO" TextColor="#FF6A00" FontAttributes="Bold" HorizontalOptions="Center"/>
                <Label x:Name="TimerLabel" Text="00:00" FontSize="48" FontAttributes="Bold" TextColor="#FFFFFF" HorizontalOptions="Center"/>
                <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                    <Button Text="-15s" BackgroundColor="#1E1E1E" TextColor="#FFFFFF" CornerRadius="10" Clicked="OnMinus15Clicked"/>
                    <Button Text="Pular" BackgroundColor="#1E1E1E" TextColor="#FFFFFF" CornerRadius="10" Clicked="OnSkipRestClicked"/>
                    <Button Text="+15s" BackgroundColor="#1E1E1E" TextColor="#FFFFFF" CornerRadius="10" Clicked="OnPlus15Clicked"/>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- Histórico Agrupado por Dia -->
        <CollectionView Grid.Row="4" x:Name="HistoryList" BackgroundColor="Transparent" IsGrouped="True">
            <CollectionView.EmptyView>
                <Label Text="Sem histórico ainda." TextColor="#888888" HorizontalOptions="Center"/>
            </CollectionView.EmptyView>
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Margin="0,10,0,5">
                        <Line HeightRequest="1" BackgroundColor="#FF6A00" WidthRequest="20" VerticalOptions="Center"/>
                        <Label Text="{Binding DateDisplay}" TextColor="#FF6A00" FontAttributes="Bold" Margin="10,0,0,0"/>
                        <Line HeightRequest="1" BackgroundColor="#FF6A00" HorizontalOptions="FillAndExpand" VerticalOptions="Center" Margin="10,0,0,0"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1E1E1E" BorderColor="#2B2B2B" Padding="15" Margin="0,0,0,10" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding SetNumber, StringFormat='Série {0}'}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16"/>
                            <Label Grid.Row="1" Grid.Column="0" TextColor="#888888" FontSize="14" VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} kg x {1} reps">
                                        <Binding Path="Weight"/>
                                        <Binding Path="Repetitions"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Text="✏️" BackgroundColor="Transparent" TextColor="#FF6A00" WidthRequest="45" HeightRequest="45" CornerRadius="10" Clicked="OnEditSetClicked"/>
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Text="🗑️" BackgroundColor="Transparent" TextColor="Red" WidthRequest="45" HeightRequest="45" CornerRadius="10" Clicked="OnDeleteSetClicked"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé com opções de Sair e Próximo/Finalizar -->
        <Grid Grid.Row="5" ColumnDefinitions="*, *" ColumnSpacing="15">
            <Button Grid.Column="0"
                    Text="SAIR"
                    BackgroundColor="#2B2B2B"
                    TextColor="#FFFFFF"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnExitClicked" />

            <Button Grid.Column="1"
                    x:Name="NextFinishBtn"
                    Text="PRÓXIMO EXERCÍCIO"
                    BackgroundColor="#FF6A00"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnNextOrFinishClicked" />
        </Grid>

    </Grid>
</ContentPage>