<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.ExerciseExecutionPage"
             BackgroundColor="#121212"
             Title="Executar Exercício">

    <Grid RowDefinitions="Auto, Auto, *, Auto" Padding="20">

        <!-- Título -->
        <Label Grid.Row="0" x:Name="TitleLabel" FontSize="28" FontAttributes="Bold" TextColor="#FFFFFF" Margin="0,20,0,20" />

        <!-- Registro da Série Atual -->
        <Border Grid.Row="1" BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="20" Margin="0,0,0,20">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <Grid ColumnDefinitions="*, Auto">
                    <Label Grid.Column="0" Text="REGISTRAR SÉRIE" TextColor="#FF6A00" FontAttributes="Bold" VerticalOptions="Center"/>
                    <Button Grid.Column="1" x:Name="LoadHistoryBtn" Text="Carregar Último" BackgroundColor="#2B2B2B" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="40" Clicked="OnLoadHistoryClicked"/>
                </Grid>

                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="15">
                    <VerticalStackLayout Grid.Column="0" Spacing="5">
                        <Label Text="Série" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="SetEntry" TextColor="#FFFFFF" Keyboard="Numeric" Text="1"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="5">
                        <Label Text="Peso (kg)" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="WeightEntry" TextColor="#FFFFFF" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="2" Spacing="5">
                        <Label Text="Reps" TextColor="#888888"/>
                        <Border BackgroundColor="#121212" Stroke="#2B2B2B" Padding="10">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>
                            <Entry x:Name="RepsEntry" TextColor="#FFFFFF" Keyboard="Numeric"/>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
                <Button x:Name="SaveBtn" Text="REGISTRAR SÉRIE" BackgroundColor="#FF6A00" TextColor="#FFFFFF" CornerRadius="10" Clicked="OnSaveSetClicked"/>
            </VerticalStackLayout>
        </Border>

        <!-- Histórico Agrupado por Dia -->
        <CollectionView Grid.Row="2" x:Name="HistoryList" BackgroundColor="Transparent" IsGrouped="True">
            <CollectionView.EmptyView>
                <Label Text="Sem histórico ainda." TextColor="#888888" HorizontalOptions="Center"/>
            </CollectionView.EmptyView>

            <!-- Cabeçalho do Dia (Linha Laranja) -->
            <CollectionView.GroupHeaderTemplate>
                <DataTemplate>
                    <StackLayout Orientation="Horizontal" Margin="0,15,0,5">
                        <Line HeightRequest="1" BackgroundColor="#FF6A00" WidthRequest="20" VerticalOptions="Center"/>
                        <Label Text="{Binding DateDisplay}" TextColor="#FF6A00" FontAttributes="Bold" Margin="10,0,0,0"/>
                        <Line HeightRequest="1" BackgroundColor="#FF6A00" HorizontalOptions="FillAndExpand" VerticalOptions="Center" Margin="10,0,0,0"/>
                    </StackLayout>
                </DataTemplate>
            </CollectionView.GroupHeaderTemplate>

            <!-- Item da Série (Com Botões) -->
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame BackgroundColor="#1E1E1E" BorderColor="#2B2B2B" Padding="15" Margin="0,0,0,10" HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto, Auto" RowDefinitions="Auto, Auto">

                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding SetNumber, StringFormat='Série {0}'}" TextColor="#FFFFFF" FontAttributes="Bold" FontSize="16"/>

                            <Label Grid.Row="1" Grid.Column="0" TextColor="#888888" FontSize="14" VerticalOptions="Center">
                                <Label.Text>
                                    <MultiBinding StringFormat="{}{0} kg x {1} reps">
                                        <Binding Path="Weight"/>
                                        <Binding Path="Repetitions"/>
                                    </MultiBinding>
                                </Label.Text>
                            </Label>

                            <!-- Botão Editar -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                    Text="✏️" BackgroundColor="Transparent" TextColor="#FF6A00"
                                    WidthRequest="45" HeightRequest="45" CornerRadius="10"
                                    Clicked="OnEditSetClicked"/>

                            <!-- Botão Excluir -->
                            <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                    Text="🗑️" BackgroundColor="Transparent" TextColor="Red"
                                    WidthRequest="45" HeightRequest="45" CornerRadius="10"
                                    Clicked="OnDeleteSetClicked"/>
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé -->
        <Button Grid.Row="3" Text="VOLTAR" BackgroundColor="#2B2B2B" TextColor="#FFFFFF" CornerRadius="10" HeightRequest="50" Clicked="OnBackClicked"/>
    </Grid>
</ContentPage>