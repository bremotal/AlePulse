<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.CreateWorkoutPage"
             BackgroundColor="#121212"
             Title="Novo Treino">

    <VerticalStackLayout Padding="20" Spacing="20">

        <Label Text="CRIAR FICHA DE TREINO"
               FontSize="24"
               FontAttributes="Bold"
               TextColor="#FFFFFF"
               Margin="0,20,0,10" />

        <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Entry x:Name="NameEntry"
                   Placeholder="Nome do Treino (ex: Treino A)"
                   PlaceholderColor="#888888"
                   TextColor="#FFFFFF" />
        </Border>

        <Border BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10" />
            </Border.StrokeShape>
            <Editor x:Name="DescriptionEntry"
                    Placeholder="Descrição (ex: Foco em Peito e Tríceps)"
                    PlaceholderColor="#888888"
                    TextColor="#FFFFFF"
                    AutoSize="TextChanges"
                    HeightRequest="100" />
        </Border>

        <Button Text="SALVAR TREINO"
                BackgroundColor="#FF6A00"
                TextColor="#FFFFFF"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnSaveClicked" />

        <Button Text="CANCELAR"
                BackgroundColor="#2B2B2B"
                TextColor="#FFFFFF"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnCancelClicked" />

    </VerticalStackLayout>
</ContentPage>