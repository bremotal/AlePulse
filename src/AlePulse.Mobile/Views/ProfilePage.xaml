<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.ProfilePage"
             BackgroundColor="{AppThemeBinding Dark=#121212, Light=#F9F9F9}"
             Title="Perfil">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- Cabeçalho com Botão Voltar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Text="‹ Voltar" BackgroundColor="Transparent" TextColor="#FF6A00" Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="MEU PERFIL" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,40,0"/>
        </Grid>

        <!-- Dados do Usuário -->
        <Border Grid.Row="1" BackgroundColor="{AppThemeBinding Dark=#1E1E1E, Light=#FFFFFF}" Stroke="{AppThemeBinding Dark=#2B2B2B, Light=#EEEEEE}" Padding="20" Margin="0,20,0,20" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <Label Text="Nome" TextColor="#888888" FontSize="14"/>
                <Label x:Name="NameLabel" TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" FontSize="20" FontAttributes="Bold"/>

                <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Dark=#2B2B2B, Light=#EEEEEE}" Margin="0,5"/>

                <Label Text="E-mail" TextColor="#888888" FontSize="14"/>
                <Label x:Name="EmailLabel" TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" FontSize="20" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

        <!-- Ações -->
        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Button Text="EDITAR DADOS" BackgroundColor="{AppThemeBinding Dark=#2B2B2B, Light=#E0E0E0}" TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" CornerRadius="10" HeightRequest="50" Clicked="OnEditProfileClicked"/>
            <Button Text="ALTERAR SENHA" BackgroundColor="{AppThemeBinding Dark=#2B2B2B, Light=#E0E0E0}" TextColor="{AppThemeBinding Dark=#FFFFFF, Light=#000000}" CornerRadius="10" HeightRequest="50" Clicked="OnChangePasswordClicked"/>
            <Button Text="SAIR DA CONTA" BackgroundColor="#FF6A00" TextColor="#FFFFFF" FontAttributes="Bold" CornerRadius="10" HeightRequest="50" Clicked="OnLogoutClicked"/>

            <!-- BOTÃO DE DEBUG PEQUENO E DISCRETO -->
            <Button Text="🛠️ Informações de Debug" 
                    BackgroundColor="Transparent" 
                    TextColor="#888888" 
                    FontSize="Micro" 
                    Padding="0,10,0,0"
                    Clicked="OnDebugClicked" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>