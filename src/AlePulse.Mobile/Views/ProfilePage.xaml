<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AlePulse.Mobile.Views.ProfilePage"
             BackgroundColor="#121212"
             Title="Perfil">

    <Grid RowDefinitions="Auto, *, Auto" Padding="20">

        <!-- Cabeçalho com Botão Voltar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *">
            <Button Grid.Column="0" Text="‹ Voltar" BackgroundColor="Transparent" TextColor="#FF6A00" Clicked="OnBackClicked"/>
            <Label Grid.Column="1" Text="MEU PERFIL" FontSize="20" FontAttributes="Bold" TextColor="#FFFFFF" VerticalOptions="Center" HorizontalOptions="Center" Margin="0,0,40,0"/>
        </Grid>

        <!-- Dados do Usuário -->
        <Border Grid.Row="1" BackgroundColor="#1E1E1E" Stroke="#2B2B2B" Padding="20" Margin="0,20,0,20" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="15" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="15">
                <Label Text="Nome" TextColor="#888888" FontSize="14"/>
                <Label x:Name="NameLabel" TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"/>

                <BoxView HeightRequest="1" BackgroundColor="#2B2B2B" Margin="0,5"/>

                <Label Text="E-mail" TextColor="#888888" FontSize="14"/>
                <Label x:Name="EmailLabel" TextColor="#FFFFFF" FontSize="20" FontAttributes="Bold"/>
            </VerticalStackLayout>
        </Border>

        <!-- Ações -->
        <VerticalStackLayout Grid.Row="2" Spacing="15">
            <Button Text="EDITAR DADOS"
                    BackgroundColor="#2B2B2B"
                    TextColor="#FFFFFF"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnEditProfileClicked"/>

            <Button Text="ALTERAR SENHA"
                    BackgroundColor="#2B2B2B"
                    TextColor="#FFFFFF"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnChangePasswordClicked"/>

            <Button Text="SAIR DA CONTA"
                    BackgroundColor="#FF6A00"
                    TextColor="#FFFFFF"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    Clicked="OnLogoutClicked"/>
        </VerticalStackLayout>

    </Grid>
</ContentPage>